    "behaviour": "Hover darkens the fill one step (lightens on night); pressed goes one more and drops 1px. Focus is a 2px ring, ink on light and chalk on dark, offset 3px. Disabled is a tint of the fill with muted text, never opacity. Labels are Instrument Sans 500, 15px, 44px tall."
  },
  "type": {
    "display": {
      "family": "Bricolage Grotesque",
      "weight": 700,
      "tracking": "normal",
      "use": "wordmark, display, headings, subheads; never running text, labels or UI"
    },
    "body": {
      "family": "Instrument Sans",
      "weight": 400
    },
    "ui": {
      "family": "Instrument Sans",
      "weight": 500
    },
    "label": {
      "family": "Instrument Sans",
      "weight": 600,
      "transform": "uppercase",
      "tracking": "0.08em"
    },
    "value": {
      "family": "Instrument Sans",
      "weight": 600,
      "numeric": "tabular-nums"
    },
    "monospace": "none anywhere (owner's call)",
    "scale-in-pack": {
      "display": "40px/1.05",
      "heading": "26px/1.15",
      "subhead": "19px/1.3",
      "body": "17px",
      "ui": "15px",
      "label": "12px",
      "value": "22px"
    }
  },
  "ui": {
    "radius": {
      "control": "6px",
      "card": "10px",
      "modal": "12px"
    },
    "height": {
      "input": "40px",
      "primary-action": "44px",
      "small": "32px",
      "chip": "28px"
    },
    "border": {
      "control": "1px",
      "control-colour": "border-control",
      "divider-colour": "divider"
    },
    "focus": {
      "ring": "2px",
      "offset": "3px"
    },
    "status": "always a symbol and a word",
    "icons": {
      "set": "Lucide",
      "stroke": "2px"
    },
    "link": "ink text with a 2px light-petrol underline, 3px offset"
  },
  "contrast": "Ink on paper 14.1:1. Paper on light petrol 3.0:1 (below AA, kept as a brand call: buttons use 500 weight at 15px or larger). Paper on raspberry 7.4:1. Ink on amber 7.8:1. Light petrol as text on paper 3.6:1, so links are ink with a light-petrol underline. Chalk on night 15.2:1. Dark primary #6BBCC6 on night 9.4:1, ink text on it 11.9:1. Raspberry as text on paper 7.4:1; on dark use #EE8FA6."
}
