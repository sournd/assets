{
  "$version": "0.1.0",
  "$source": "design/BRAND.md and design/sournd Brand Pack.dc.html. Transcribed, nothing added.",
  "colour": {
    "paper": {
      "value": "#F3F0EA",
      "use": "light surface; text on petrol and raspberry buttons"
    },
    "ink": {
      "value": "#1D2226",
      "use": "light text; text on amber and on the dark-mode primary"
    },
    "night": {
      "value": "#141A1C",
      "use": "dark surface"
    },
    "chalk": {
      "value": "#EDF0EE",
      "use": "dark-mode text only, never an accent"
    },
    "petrol": {
      "light": "#3A97A3",
      "dark": "#6BBCC6",
      "use": "THE primary accent: buttons, links, selection, focus, icon tile. Paper text on light; ink text on dark"
    },
    "petrol-deep": {
      "light": "#0E7482",
      "dark": "#3A97A3",
      "use": "logo only (the s and nd)"
    },
    "raspberry": {
      "light": "#9E1F4A",
      "dark": "#E0577F",
      "text-on-dark": "#EE8FA6",
      "use": "secondary accent: controls, control buttons, live states, knob pointers, fader thumbs, playhead. Never fills a surface or marks status. Paper text on it"
    },
    "amber": {
      "value": "#F4A340",
      "text-on-light": "#9A4A0B",
      "use": "highlights (new, picks), never a warning. Ink text on it"
    },
    "muted": {
      "light": "#545B60",
      "dark": "#A7B1B3",
      "use": "secondary text and labels"
    },
    "border-control": {
      "light": "#7F868A",
      "dark": "#6F7B7E",
      "use": "1px control borders"
    },
    "divider": {
      "light": "#D9D5CC",
      "dark": "#283235",
      "use": "dividers"
    },
    "retired": [
      "#0F5C68"
    ]
  },
  "logo": {
    "light": {
      "s-nd": "#0E7482",
      "OUR": "#3A97A3"
    },
    "dark": {
      "s-nd": "#3A97A3",
      "OUR": "#6BBCC6"
    },
    "rule": "Two petrols, never an accent colour. On dark the whole word steps up one tone together. Minimum 16px cap height; below that use the icon. Clear space equals the height of the n."
  },
  "icon": {
    "tile": "#3A97A3",
